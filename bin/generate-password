#!/bin/bash

password_length=${1:-32}

if [[ "$password_length" -lt 8 ]]; then
  echo "Error: Password length must be at least 8 characters." >&2
  return 1
fi

alpha_num='A-Za-z0-9'
char_set='A-Za-z0-9!@#$%^&*()_+-='

if [[ -n "${2}" && "alphabets" != {{2,,}}* ]]; then
  char_set=${alpha_num}
fi

_pick_random() {
  cat /dev/urandom | LC_ALL=C tr -dc "$1" | head -c $2
}

first=$(_pick_random "${alpha_num}" 1)
last=$(_pick_random "${alpha_num}" 1)
middle=$(_pick_random "${char_set}" $((password_length - 2)))

echo "${first}${middle}${last}"
