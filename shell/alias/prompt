if [ -n "$ZSH_VERSION" ]; then
    function fish_style_pwd() {
      echo $(pwd | sed "s|^$HOME|~|; s-\([^/]\)[^/]*/-\1/-g")
    }

    setopt PROMPT_SUBST
    PROMPT='%F{white}%* %F{green}%n%f@%m %F{green}$(fish_style_pwd)%f %F{yellow}!%!%f %# '
elif [ -n "$BASH_VERSION" ]; then
    PS1='\[\n\t \u@\h \w\n$ \]'
fi
